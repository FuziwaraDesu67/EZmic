<Window x:Class="MicCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EZmic" 
        Icon="Assets/icon.png"
        Height="680" Width="460"
        MinHeight="620" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        Background="#0D0E12" Foreground="#E6EDF3">

    <Window.Resources>
        <!-- Typography & Shared Hardware Palette -->
        <SolidColorBrush x:Key="ChassisBg" Color="#0D0E12"/>
        <SolidColorBrush x:Key="PanelBg" Color="#14161C"/>
        <SolidColorBrush x:Key="ControlBg" Color="#1A1D24"/>
        <SolidColorBrush x:Key="ControlHover" Color="#222630"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#262A33"/>
        <SolidColorBrush x:Key="BorderHairline" Color="#1E222A"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E6EDF3"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8B949E"/>
        <SolidColorBrush x:Key="TextMuted" Color="#484F58"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <!-- Segmented Hardware Button -->
        <Style x:Key="HardwareButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Background" Value="#1E222A"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ControlHover}"/>
                    <Setter Property="BorderBrush" Value="#383E4B"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#15181E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Primary Broadcast Button -->
        <Style x:Key="BroadcastButton" TargetType="Button" BasedOn="{StaticResource HardwareButton}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="#042F1E"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#059669"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Dark Styling -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource ControlBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Segmented Radio Button for Transports -->
        <Style x:Key="SegmentedRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252A34"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E6EDF3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Tally -->
            <RowDefinition Height="Auto"/> <!-- Transport Segmented Bar -->
            <RowDefinition Height="Auto"/> <!-- Audio Output -->
            <RowDefinition Height="Auto"/> <!-- Precision LED Meter -->
            <RowDefinition Height="Auto"/> <!-- Gain & Mute Controls -->
            <RowDefinition Height="*"/>    <!-- Activity Terminal -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 1. Header with Live Tally Pill -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="EZmic" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Studio microphone bridge" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Authentic Broadcast Tally -->
            <Border Grid.Column="1" x:Name="BorderTally" Background="#14181E" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="DotTally" Width="7" Height="7" Fill="{StaticResource TextMuted}" Margin="0,0,7,0"/>
                    <TextBlock x:Name="TxtTally" Text="STANDBY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Connection Transport Selector (Segmented Hardware Well) -->
        <Border Grid.Row="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Transport" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                
                <!-- Recessed Segmented Track -->
                <Border Background="#0D0F13" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="8" Padding="3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="RbWifi" Content="Wi-Fi" IsChecked="True" Style="{StaticResource SegmentedRadio}" Grid.Column="0"/>
                        <RadioButton x:Name="RbUsb" Content="USB" Style="{StaticResource SegmentedRadio}" Grid.Column="1"/>
                        <RadioButton x:Name="RbBluetooth" Content="Bluetooth" Style="{StaticResource SegmentedRadio}" Grid.Column="2"/>
                    </Grid>
                </Border>

                <!-- Action Button & Connection Readout -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnConnect" Content="Start receiver" Style="{StaticResource BroadcastButton}" Width="140" Height="36" Click="BtnConnect_Click" Grid.Column="0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock x:Name="TxtStatus" Text="Ready to connect" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 3. Target Audio Endpoint Selection -->
        <Border Grid.Row="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Audio endpoint" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="WASAPI Shared" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                </Grid>
                <ComboBox x:Name="CmbOutputDevices" Height="34"/>
                <TextBlock Text="Discord and games should listen to CABLE Output." FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>

                <!-- Driver Helper Banner (shown when VB-Cable is missing) -->
                <Border x:Name="BorderDriverNotice" Background="#1C1812" BorderBrush="#EAB308" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Virtual cable not found (needed for Discord/games)." FontSize="11" Foreground="#FDE047" VerticalAlignment="Center"/>
                        <Button x:Name="BtnInstallDriver" Content="Install Free Cable" Grid.Column="1" Click="BtnInstallDriver_Click" Padding="10,3" Height="26" FontSize="11" Background="#EAB308" Foreground="#000000" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- 4. Hero Moment: Precision Segmented 24-LED Broadcast VU Meter -->
        <Border Grid.Row="3" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Input level" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock x:Name="TxtLevelDecibel" Text="-inf dB" FontSize="11" FontFamily="Consolas, monospace" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Recessed Milled Meter Well -->
                <Border Background="#090A0D" BorderBrush="#1C2028" BorderThickness="1" CornerRadius="6" Padding="6,8">
                    <Canvas x:Name="CanvasMeter" Height="14" HorizontalAlignment="Stretch" ClipToBounds="True"/>
                </Border>

                <!-- Calibrated Decibel Scale Markings -->
                <Grid Margin="6,4,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="-42" FontSize="9" Foreground="{StaticResource TextMuted}" Grid.Column="0" FontFamily="Consolas, monospace"/>
                    <TextBlock Text="-24" FontSize="9" Foreground="{StaticResource TextMuted}" Grid.Column="1" FontFamily="Consolas, monospace"/>
                    <TextBlock Text="-12" FontSize="9" Foreground="{StaticResource TextMuted}" Grid.Column="2" FontFamily="Consolas, monospace"/>
                    <TextBlock Text="-6" FontSize="9" Foreground="{StaticResource TextMuted}" Grid.Column="3" FontFamily="Consolas, monospace"/>
                    <TextBlock Text="0 dB" FontSize="9" Foreground="{StaticResource TextMuted}" Grid.Column="4" FontFamily="Consolas, monospace"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 5. Gain Fader & Hardware Mute -->
        <Border Grid.Row="4" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Gain" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock x:Name="TxtGainValue" Text="100%" FontSize="11" FontFamily="Consolas, monospace" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="SliderGain" Minimum="50" Maximum="400" Value="100" 
                            TickFrequency="25" IsSnapToTickEnabled="True" ValueChanged="SliderGain_ValueChanged"/>
                </StackPanel>

                <Button x:Name="BtnMute" Content="Mute" Style="{StaticResource HardwareButton}" Width="80" Height="36" Grid.Column="1" VerticalAlignment="Center" Click="BtnMute_Click"/>
            </Grid>
        </Border>

        <!-- 6. Compact Terminal Log -->
        <Border Grid.Row="5" Background="#090A0E" BorderBrush="{StaticResource BorderHairline}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="Activity" DockPanel.Dock="Top" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                <ScrollViewer x:Name="ScrollLog" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtLog" Background="Transparent" Foreground="{StaticResource TextSecondary}" BorderThickness="0" 
                             IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 7. Footer Options -->
        <Grid Grid.Row="6" Margin="2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="ChkStartup" Content="Launch on startup" Grid.Column="0" 
                      Foreground="{StaticResource TextSecondary}" FontSize="11" Click="ChkStartup_Click"/>
            <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize to tray on close" IsChecked="True" Grid.Column="1" 
                      Foreground="{StaticResource TextSecondary}" FontSize="11" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>
