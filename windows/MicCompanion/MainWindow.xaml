<Window x:Class="MicCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EZmic" 
        Icon="Assets/icon.png"
        Height="780" Width="430"
        MinHeight="680" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        Background="#0C0E11" Foreground="#FFFFFF"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Modern Stealth Palette -->
        <SolidColorBrush x:Key="WindowBg" Color="#0C0E11"/>
        <SolidColorBrush x:Key="CardBg" Color="#16191D"/>
        <SolidColorBrush x:Key="BorderDark" Color="#1E2228"/>
        <SolidColorBrush x:Key="TextWhite" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextGray" Color="#8E959E"/>
        <SolidColorBrush x:Key="TextDarkMuted" Color="#5A626A"/>
        <SolidColorBrush x:Key="MintAccent" Color="#2EE59D"/>
        <SolidColorBrush x:Key="MintDarkBg" Color="#0B281E"/>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, sans-serif"/>
            <Setter Property="Foreground" Value="{StaticResource TextWhite}"/>
        </Style>

        <!-- Modern Mint Slider Style with White Circular Thumb -->
        <Style x:Key="FigmaMintSlider" TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="#22262E"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{StaticResource MintAccent}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="#FFFFFF">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.3"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Toggle Switch (Mint ON / Gray OFF) -->
        <Style x:Key="FigmaToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="SwitchBorder" Width="40" Height="22" CornerRadius="11" Background="#22262E" Padding="2" SnapsToDevicePixels="True">
                            <Ellipse x:Name="SwitchKnob" Width="18" Height="18" Fill="#FFFFFF" HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchBorder" Property="Background" Value="{StaticResource MintAccent}"/>
                                <Setter TargetName="SwitchKnob" Property="Fill" Value="#091E16"/>
                                <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DSP Chip Pill Toggle -->
        <Style x:Key="FigmaDspChip" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ChipBorder" CornerRadius="16" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="16,7">
                            <ContentPresenter x:Name="ChipText" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="#707782"/>
                                </TextBlock.Foreground>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{StaticResource MintDarkBg}"/>
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{StaticResource MintAccent}"/>
                                <Setter TargetName="ChipText" Property="TextElement.Foreground" Value="{StaticResource MintAccent}"/>
                                <Setter TargetName="ChipText" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Dock Tab Button (Zero Default Chrome / No Blue Hover) -->
        <Style x:Key="SegmentedDockButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="Transparent" BorderThickness="0" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Figma Dark ComboBoxItem Style -->
        <Style x:Key="FigmaComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="12,8" Margin="3,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#22262E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource MintDarkBg}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource MintAccent}"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource MintAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton for Dark ComboBox -->
        <ControlTemplate x:Key="FigmaComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{StaticResource TextGray}" Data="M 0 0 L 4 4 L 8 0 Z"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource MintAccent}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Figma Dark ComboBox Style -->
        <Style x:Key="FigmaComboBox" TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="#1E2228"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource FigmaComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          Template="{StaticResource FigmaComboBoxToggleButton}" 
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"  
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,28,0" 
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#16191D" BorderThickness="1" BorderBrush="{StaticResource BorderDark}" CornerRadius="8" Margin="0,4,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="4" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="2,4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Figma Card ComboBox (Transparent background for Card headers) -->
        <Style x:Key="FigmaCardComboBox" TargetType="ComboBox" BasedOn="{StaticResource FigmaComboBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ========================================== -->
        <!-- SCREEN 1: EZmic / Main (Default Screen)    -->
        <!-- ========================================== -->
        <ScrollViewer x:Name="GridMainView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,20">

                <!-- 1. Header: EZmic + Standby status + Three-dot Settings -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title -->
                    <TextBlock Text="EZmic" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>

                    <!-- Status Indicator (Dot + Text) -->
                    <Border x:Name="BorderTally" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0" Padding="6,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="DotTally" Width="7" Height="7" Fill="#8B949E" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTally" Text="Standby" FontSize="13" Foreground="{StaticResource TextGray}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Three-Dot Settings Button -->
                    <Button x:Name="BtnSettings" Grid.Column="2" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnSettings_Click" Padding="6,2">
                        <TextBlock Text="•••" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextGray}"/>
                    </Button>
                </Grid>

                <!-- Update Available Notification Banner -->
                <Border x:Name="BorderUpdateBanner" Background="#0E2319" BorderBrush="{StaticResource MintAccent}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,16" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtUpdateTitle" Text="New update available" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource MintAccent}"/>
                            <TextBlock x:Name="TxtUpdateNotes" Text="Click Update to apply the latest security patches." FontSize="11" Foreground="{StaticResource TextGray}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button x:Name="BtnApplyUpdate" Grid.Column="1" Content="Update" Click="BtnApplyUpdate_Click" Background="{StaticResource MintAccent}" Foreground="#091E16" FontWeight="SemiBold" FontSize="11" Padding="12,4" Height="26" Cursor="Hand" BorderThickness="0" Margin="8,0,4,0">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnDismissUpdate" Grid.Column="2" Content="✕" Click="BtnDismissUpdate_Click" Background="Transparent" Foreground="{StaticResource TextGray}" FontSize="12" Padding="6,2" Cursor="Hand" BorderThickness="0"/>
                    </Grid>
                </Border>

                <!-- 2. Connection Type Segmented Control (Pill switcher) -->
                <Border Background="{StaticResource CardBg}" CornerRadius="12" Height="44" Padding="3" Margin="0,0,0,16">
                    <Grid x:Name="DockSliderTrack" SizeChanged="DockSliderTrack_SizeChanged">
                        <!-- Sliding Indicator Pill -->
                        <Border x:Name="LiquidIndicator" HorizontalAlignment="Left" Background="#22262E" CornerRadius="9">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="LiquidTransform" X="0"/>
                            </Border.RenderTransform>
                        </Border>

                        <!-- Tab Buttons -->
                        <UniformGrid Columns="3">
                            <Button x:Name="BtnTabWifi" Style="{StaticResource SegmentedDockButton}" Tag="WIFI" Click="BtnMode_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path x:Name="IconWifi" Width="13" Height="13" Stretch="Uniform" Fill="{StaticResource MintAccent}" Margin="0,0,6,0"
                                          Data="M12 4C7.31 4 3.07 5.9 0 8.98L12 21 24 8.98C20.93 5.9 16.69 4 12 4M2.92 10.42C5.46 8.28 8.61 7 12 7S18.54 8.28 21.08 10.42L12 19.53 2.92 10.42Z"/>
                                    <TextBlock x:Name="TxtWifi" Text="Wi-Fi" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnTabUsb" Style="{StaticResource SegmentedDockButton}" Tag="USB" Click="BtnMode_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path x:Name="IconUsb" Width="13" Height="13" Stretch="Uniform" Fill="{StaticResource TextGray}" Margin="0,0,6,0"
                                          Data="M15 7V4H16V2H8V4H9V7L7 9V17H11V22H13V17H17V9L15 7M9 15V10.83L10.83 9H13.17L15 10.83V15H9Z"/>
                                    <TextBlock x:Name="TxtUsb" Text="USB" FontWeight="Medium" FontSize="13" Foreground="{StaticResource TextGray}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnTabBluetooth" Style="{StaticResource SegmentedDockButton}" Tag="BLUETOOTH" Click="BtnMode_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path x:Name="IconBluetooth" Width="11" Height="13" Stretch="Uniform" Fill="{StaticResource TextGray}" Margin="0,0,6,0"
                                          Data="M14.88 16.29L13 18.17V14.41M13 5.83L14.88 7.71L13 9.59M17.71 7.71L12 2H11V10.59L6.41 6L5 7.41L10.59 13L5 18.59L6.41 20L11 15.41V24H12L17.71 18.29L13.41 14L17.71 9.71C18.1 9.32 18.1 8.68 17.71 8.29V8.29C17.71 7.9 17.71 7.71 17.71 7.71Z"/>
                                    <TextBlock x:Name="TxtBluetooth" Text="Bluetooth" FontWeight="Medium" FontSize="13" Foreground="{StaticResource TextGray}"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!-- USB 1-Click Phone Installer Helper (Shows in USB mode) -->
                <Border x:Name="BorderUsbHelper" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,16" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Connect phone via USB cable" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextWhite}"/>
                            <TextBlock x:Name="TxtUsbDeviceStatus" Text="Plug in USB &amp; enable USB debugging" FontSize="11" Foreground="{StaticResource TextGray}"/>
                        </StackPanel>
                        <Button x:Name="BtnInstallApkToPhone" Grid.Column="1" Content="📲 Install to Phone" Click="BtnInstallApkToPhone_Click" Background="#22262E" Foreground="{StaticResource MintAccent}" FontWeight="SemiBold" FontSize="11" Padding="10,4" Height="28" Cursor="Hand" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>

                <!-- 3. Primary CTA: Start receiver (Big Mint Button) -->
                <Button x:Name="BtnConnect" Height="50" Content="Start receiver" Click="BtnConnect_Click"
                        Background="{StaticResource MintAccent}" Foreground="#091E16"
                        FontWeight="Bold" FontSize="16" Cursor="Hand" BorderThickness="0" Margin="0,0,0,8">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Subtitle: Ready · IP address / Status -->
                <TextBlock x:Name="TxtStatus" Text="Ready · 192.168.1.100" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,0,0,20"/>

                <!-- 4. Output Device Selection Card -->
                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Output" FontSize="11" Foreground="{StaticResource TextDarkMuted}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="CmbOutputDevices" Style="{StaticResource FigmaComboBox}"/>

                        <!-- Driver Install Banner (Shown if EZmic virtual mic not found) -->
                        <Border x:Name="BorderDriverNotice" Background="#18231C" BorderBrush="{StaticResource MintAccent}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtDriverNotice" Text="Virtual microphone needed for games" FontSize="11" Foreground="{StaticResource MintAccent}" VerticalAlignment="Center"/>
                                <Button x:Name="BtnInstallDriver" Content="Install Virtual Mic" Grid.Column="1" Click="BtnInstallDriver_Click" Padding="10,4" Height="26" FontSize="11" Background="{StaticResource MintAccent}" Foreground="#091E16" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 5. Input Level & Mute Row -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Input level + Bar meter -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Input level" FontSize="13" Foreground="{StaticResource TextWhite}"/>
                            <TextBlock x:Name="TxtLevelDecibel" Text="-∞ dB" FontSize="12" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Canvas x:Name="CanvasMeter" Height="6" Background="#22262E" SizeChanged="CanvasMeter_SizeChanged"/>
                    </StackPanel>

                    <!-- Right: Mute Pill Button -->
                    <Button x:Name="BtnMute" Grid.Column="2" Click="BtnMute_Click" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="16,8" Cursor="Hand" VerticalAlignment="Center">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="20"/></Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎙️" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="Mute" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextWhite}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 6. Gain Control -->
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Gain" FontSize="14" Foreground="{StaticResource TextWhite}"/>
                    <TextBlock x:Name="TxtGainValue" Text="100%" FontSize="13" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right"/>
                </Grid>
                <Slider x:Name="SliderGain" Minimum="0" Maximum="300" Value="100" Style="{StaticResource FigmaMintSlider}" ValueChanged="SliderGain_ValueChanged" Margin="0,0,0,14"/>

                <!-- 7. Noise Gate Control -->
                <Grid Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Noise gate" FontSize="14" Foreground="{StaticResource TextWhite}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkNoiseGate" IsChecked="True" Style="{StaticResource FigmaToggleSwitch}" Click="ChkNoiseGate_Click" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtGateThreshold" Text="-45 dB" FontSize="13" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <Slider x:Name="SliderNoiseGate" Minimum="-60" Maximum="-10" Value="-45" Style="{StaticResource FigmaMintSlider}" ValueChanged="SliderNoiseGate_ValueChanged" Margin="0,0,0,16"/>

                <!-- Subtle Section Divider -->
                <Border Height="1" Background="{StaticResource BorderDark}" Margin="0,0,0,16"/>

                <!-- 8. Voice Enhancer (DSP Processing) -->
                <TextBlock Text="Voice enhancer" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextWhite}" Margin="0,0,0,10"/>

                <!-- Preset Selector Card -->
                <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ComboBox x:Name="CmbStudioProfile" SelectedIndex="0" SelectionChanged="CmbStudioProfile_SelectionChanged" Style="{StaticResource FigmaCardComboBox}">
                                <ComboBoxItem Content="Broadcast Warmth"/>
                                <ComboBoxItem Content="Crisp Gamer"/>
                                <ComboBoxItem Content="Podcast Pro"/>
                                <ComboBoxItem Content="Studio Flat (Off)"/>
                            </ComboBox>
                            <TextBlock x:Name="TxtProfileDescription" Text="Shure SM7B curve" FontSize="12" Foreground="{StaticResource TextGray}" Margin="4,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DSP Quick Chips: Compressor, De-esser, Listen -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <CheckBox x:Name="ChkCompressor" Content="Compressor" IsChecked="True" Click="ChkCompressor_Click" Style="{StaticResource FigmaDspChip}" Margin="0,0,10,0"/>
                    <CheckBox x:Name="ChkDeEsser" Content="De-esser" IsChecked="True" Click="ChkDeEsser_Click" Style="{StaticResource FigmaDspChip}" Margin="0,0,10,0"/>
                    <CheckBox x:Name="ChkSidetone" Content="Listen" IsChecked="False" Click="ChkSidetone_Click" Style="{StaticResource FigmaDspChip}"/>
                </StackPanel>

                <!-- 9. Footer: Version + Mute Hotkey Hint -->
                <Grid Margin="0,0,0,4">
                    <TextBlock x:Name="TxtAppVersion" Text="v1.1.8" FontSize="11" Foreground="{StaticResource TextDarkMuted}"/>
                    <TextBlock Text="Mute hotkey Ctrl + Shift + M" FontSize="11" Foreground="{StaticResource TextDarkMuted}" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Hidden elements for code-behind bindings -->
                <TextBlock x:Name="TxtLanIp" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtModeBadge" Visibility="Collapsed"/>
                <TextBox x:Name="TxtLog" Visibility="Collapsed"/>
                <Ellipse x:Name="DotGateStatus" Visibility="Collapsed"/>
                <TextBlock x:Name="BadgeDspStatus" Visibility="Collapsed"/>
                <ProgressBar x:Name="ProgressUpdate" Visibility="Collapsed"/>

            </StackPanel>
        </ScrollViewer>

        <!-- ========================================== -->
        <!-- SCREEN 2: EZmic / Settings View            -->
        <!-- ========================================== -->
        <Border x:Name="GridSettingsView" Background="{StaticResource WindowBg}" Visibility="Collapsed" Padding="24,20,24,20">
            <StackPanel>

                <!-- Header: Back Arrow + Settings Title -->
                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnBackFromSettings" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnBackFromSettings_Click" Padding="4,2" Margin="0,0,12,0">
                        <TextBlock Text="❮" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextWhite}"/>
                    </Button>
                    <TextBlock Grid.Column="1" Text="Settings" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>

                <!-- System Preferences -->
                <Grid Margin="0,0,0,18">
                    <TextBlock Text="Launch on startup" FontSize="14" Foreground="{StaticResource TextWhite}" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ChkStartup" Click="ChkStartup_Click" Style="{StaticResource FigmaToggleSwitch}" HorizontalAlignment="Right"/>
                </Grid>

                <Grid Margin="0,0,0,24">
                    <TextBlock Text="Minimize to tray on close" FontSize="14" Foreground="{StaticResource TextWhite}" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ChkMinimizeToTray" IsChecked="True" Style="{StaticResource FigmaToggleSwitch}" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Divider -->
                <Border Height="1" Background="{StaticResource BorderDark}" Margin="0,0,0,20"/>

                <!-- Links & Updates -->
                <Button x:Name="BtnCheckUpdates" Click="BtnCheckUpdates_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0,10" Margin="0,0,0,8" HorizontalContentAlignment="Stretch">
                    <Grid>
                        <TextBlock Text="Check for updates" FontSize="14" Foreground="{StaticResource TextWhite}" VerticalAlignment="Center"/>
                        <TextBlock Text="v1.1.8 ❯" FontSize="13" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <Button x:Name="BtnBuyCoffee" Click="BtnBuyCoffee_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0,10" Margin="0,0,0,8" HorizontalContentAlignment="Stretch">
                    <Grid>
                        <TextBlock Text="Support the developer" FontSize="14" Foreground="{StaticResource TextWhite}" VerticalAlignment="Center"/>
                        <TextBlock Text="Buy me a coffee ❯" FontSize="13" Foreground="{StaticResource TextGray}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

                <Button x:Name="BtnUninstall" Click="BtnUninstall_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0,10" Margin="0,0,0,8" HorizontalContentAlignment="Stretch">
                    <Grid>
                        <TextBlock Text="Uninstall EZmic" FontSize="14" Foreground="#EF4444" VerticalAlignment="Center"/>
                        <TextBlock Text="Clean removal ❯" FontSize="13" Foreground="{StaticResource TextDarkMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Button>

            </StackPanel>
        </Border>

    </Grid>
</Window>
